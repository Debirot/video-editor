{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor",
  "version": "0.1.0",
  "identifier": "dev.editor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "backgroundColor": "#0E0F11",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: media: http://media.localhost",
        "media-src": "'self' blob: media: http://media.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost media: http://media.localhost ws://localhost:1420",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
